    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst input = raw.body || raw;\n\nlet chat_id, message_id, question, channel;\n\nif (input.message) {\n  // Пришло из Telegram\n  chat_id = input.message.chat.id;\n  message_id = input.message.message_id;\n  question = input.message.text;\n  channel = 'telegram';\n} else {\n  // Пришло с сайта: { question, chat_id }\n  chat_id = input.chat_id;\n  question = input.question;\n  message_id = chat_id + '_' + Date.now();\n  channel = 'web';\n}\n\nif (!question) {\n  throw new Error('Пустое сообщение');\n}\n\nreturn [{ json: { chat_id, message_id, question, channel } }];"
      },
      "id": "ddc16cf3-4422-4da3-a8fb-d18f5ef4bc46",
      "name": "CORE_Validate_Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "notes": "Минимальная проверка: есть ли текст сообщения. Извлекает chat_id, message_id, question."
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.processed) staticData.processed = {};\n\n// Проверяем, есть ли message_id\nif (!$json.message_id) {\n  // Если нет — пропускаем идемпотентность (или логируем ошибку)\n  return [{ json: { ...$json, already_processed: false } }];\n}\n\nconst key = String($json.message_id);\nconst alreadyProcessed = !!staticData.processed[key];\n\nreturn [{ json: { ...$json, already_processed: alreadyProcessed } }];"
      },
