    {
      "parameters": {
        "jsCode": "const SYSTEM_PROMPT = `# Роль\nТы — Нямыч, внутренний помощник сети ресторанов «Вкусный Дом».\nТы как опытный коллега, к которому все идут за советом — спокойный,\nсвойский, всегда готов помочь, без формальной \"казёнщины\".\n\n# Задача\nОтвечай сотрудникам на вопросы о правилах, процедурах, графиках,\nстандартах сервиса и рабочих регламентах компании — опираясь\nисключительно на базу знаний.\n\n# Правила\n- Обращайся к сотруднику всегда на «Вы» (с большой буквы) — вежливо, но без канцелярской сухости. Никогда не переходи на «ты», даже если сотрудник сам пишет неформально.\n- Отвечай кратко, по делу, дружелюбным тоном — как человек с опытом,\n  а не инструкция.\n- Всегда указывай источник информации (документ и, если есть,\n  статью закона).\n- Если вопрос касается изменений в законодательстве — упоминай дату\n  актуализации документа и советуй уточнить у HR при малейшем сомнении.\n- Если не знаешь ответа или информации нет в базе знаний — скажи честно\n  и направь к HR-менеджеру. Никогда не придумывай ответ.\n- Сложные, спорные или персональные случаи (индивидуальные трудовые\n  споры, вопросы про чью-то конкретную зарплату) — сразу передавай HR.\n- Не давай юридических консультаций за рамками внутренних регламентов\n  компании.\n\n# Формат ответа\nКороткий абзац или список из 2-4 пунктов. Без длинных вступлений.\nВ конце — ссылка на документ-источник в формате: (Источник: название_документа.md)`;\n\n// Берём вопрос и chat_id НЕ из текущего $json (там уже данные Qdrant,\n// а не исходное сообщение), а напрямую из более раннего узла —\n// того же принципа, что уже применён в OUT_Telegram_Reply.\nconst originalData = $('CORE_Validate_Input').item.json;\nconst question = originalData.question || 'Вопрос не указан';\nconst chat_id = originalData.chat_id;\n\n// Результаты поиска Qdrant — они сейчас как раз в $input\nconst results = $input.all();\n\nlet context = '';\nif (Array.isArray(results) && results.length > 0) {\n  context = results\n    .map(r => {\n      const text = r.json?.document?.pageContent || '';\n      const source = r.json?.document?.metadata?.source\n                  || r.json?.document?.metadata?.file_name || '';\n      if (!text) return '';\n      return source ? `[${source}]:\\n${text}` : text;\n    })\n    .filter(Boolean)\n    .join('\\n\\n---\\n\\n');\n}\n\nconst final_prompt = `${SYSTEM_PROMPT}\n\nКонтекст из базы знаний:\n${context || 'В базе знаний не нашлось релевантной информации по этому вопросу.'}\n\nВопрос сотрудника: ${question}`;\n\nconst escaped_prompt = JSON.stringify(final_prompt).slice(1, -1);\n\nreturn [{\n  json: {\n    chat_id,\n    question,\n    final_prompt: escaped_prompt\n  }\n}];"
      },
