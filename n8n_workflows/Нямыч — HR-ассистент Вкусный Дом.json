    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// Берём данные из входящего сообщения\nconst chat_id = $json.chat_id || $input.first().json.chat_id;\nconst question = $json.question || $input.first().json.question;\nconst message_id = $json.message_id || $input.first().json.message_id;\nconst answer_text = $json.answer_text || $input.first().json.answer_text;\n\n// Сохраняем в статическое хранилище\nif (message_id) {\n  if (!staticData.processed) staticData.processed = {};\n  staticData.processed[String(message_id)] = { \n    stage: 'answer_generated', \n    ts: Date.now() \n  };\n}\n\n// Возвращаем исходные данные, не меняя их\nreturn [{\n  json: {\n    chat_id: chat_id,\n    question: question,\n    message_id: message_id,\n    answer_text: answer_text\n  }\n}];"
