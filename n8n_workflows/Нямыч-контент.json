      "name": "Code_news"
    },
    {
      "parameters": {
        "jsCode": "const rawName = $input.first().json.body?.file || \"\";\n\n// убираем всё, кроме букв (в т.ч. кириллицы), цифр, точки, подчёркивания и дефиса\nconst safeName = rawName.replace(/[^a-zA-Zа-яА-ЯёЁ0-9._-]/g, \"\");\n\nif (!safeName.endsWith(\".md\") || safeName.includes(\"..\")) {\n  throw new Error(\"Недопустимое имя файла: \" + rawName);\n}\n\nreturn [{ json: { fileName: safeName } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        32
      ],
      "id": "f5add5a6-c43d-4c9c-b52c-1bd8236f46db",
      "name": "Code_docs"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst employee = items.map(item => {\n  const f = item.json.fields;\n  const photoArr = f.photo || [];\n  const photoUrl = photoArr.length > 0\n    ? (photoArr[0].signedUrl || photoArr[0].url || photoArr[0].path)\n    : null;\n\n  return {\n    name: f.name,\n    point: f.point,\n    comment: f.comment,\n    period: f.period,\n    photo: photoUrl\n  };\n});\n\nreturn [{ json: { employee } }];"
      },
      "type": "n8n-nodes-base.code",
