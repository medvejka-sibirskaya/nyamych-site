    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst news = items.map(item => ({\n  title: item.json.fields.Title,\n  text: item.json.fields.text,\n  date: item.json.fields.date\n}));\n\nreturn [{ json: { news } }];"
      },
